{
  "description": "Explicador: exige la explicación del cambio, al día, antes de abrir un PR",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create *)",
            "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/hooks/exigir_explicacion.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
